{
  "defaults": {
    "platform": "commercial",
    "requestsPerSecond": 1,
    "timeoutMs": 30000,
    "maxRetries": 5
  },
  "platforms": {
    "commercial": {
      "label": "Commercial",
      "host": "https://api.grid.gg",
      "keyEnv": "GRID_API_KEY"
    },
    "open-access": {
      "label": "Open Access",
      "host": "https://api-op.grid.gg",
      "keyEnv": "GRID_OA_API_KEY"
    }
  },
  "apis": {
    "central-data": {
      "name": "Central Data",
      "path": "/central-data/graphql"
    },
    "series-state": {
      "name": "Series State",
      "path": "/live-data-feed/series-state/graphql"
    },
    "stats-feed": {
      "name": "Stats Feed",
      "path": "/statistics-feed/graphql"
    }
  }
}
