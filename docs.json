                "pages": [
                  "data-apis/getting-started",
                  "data-apis/development-tools"
                ]
              },
              {
                "group": "Central Data API",
                "pages": [
                  "data-apis/central-data/overview",
                  "data-apis/central-data/entities",
                  {
                    "group": "Tutorials",
                    "pages": [
                      "data-apis/central-data/tutorials/all-series-for-tournament",
                      "data-apis/central-data/tutorials/first-10-series-day",
                      "data-apis/central-data/tutorials/get-team-player-photos"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Central Data API",
                "pages": [
                  "data-apis/central-data/api-reference/introduction",
                  {
                    "group": "Operations",
                    "expanded": false,
                    "pages": [
                      {
                        "group": "Queries",
                        "expanded": false,
                        "pages": [
                          "data-apis/central-data/api-reference/queries/allSeries"
                        ]
                      }
                    ]
                  },
                  {
                    "group": "Types",
                    "expanded": false,
                    "pages": [
                      {
                        "group": "Objects",
                        "expanded": false,
                        "pages": [
                          "data-apis/central-data/api-reference/objects/Series"
                        ]
                      },
                      {
                        "group": "Filters",
                        "expanded": false,
                        "pages": [
                          "data-apis/central-data/api-reference/filters/SeriesFilter"
                        ]
                      },
                      "data-apis/central-data/api-reference/connections"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://blog.grid.gg/",
          "icon": "newspaper"
        },
        {
          "anchor": "Knowledge Base",
          "href": "https://grid.helpjuice.com/",
          "icon": "book-open-cover"
        }
      ]
    }
