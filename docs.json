{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GRID",
  "colors": {
    "primary": "#1FDAFF",
    "light": "#1FDAFF",
    "dark": "#1FDAFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#131415"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "navigation": {
